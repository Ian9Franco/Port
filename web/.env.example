# Path to Port repo root (default: parent of web/)
PORT_REPO_ROOT=..

# local = read/write data/*.json on disk (dev / self-hosted)
# github = read/write via GitHub API + dispatch Actions (Vercel)
PORT_DATA_BACKEND=local

# Required when PORT_DATA_BACKEND=github
GITHUB_TOKEN=
GITHUB_REPOSITORY=Ian9Franco/Port
GITHUB_REF=main
RADAR_WORKFLOW_FILE=opportunity-radar.yml

# Optional: simple cookie auth (recommended in production)
PORT_UI_SECRET=
